# Tribe Harbor Phone environment variables — NAMES ONLY, no real values here.
# Copy to .env.local for local dev. In production these come from Cloud Run
# env vars + Secret Manager (see docs/deploy.md). Never commit real values.

# --- Twilio identifiers (not secret, but account-specific) ---
# Console home page → Account Info
TWILIO_ACCOUNT_SID=
# Console → Account → API keys & tokens → Create API key (SK...)
TWILIO_API_KEY_SID=
# The Trifecta Benefits number in E.164, e.g. +15551234567
# Console → Phone Numbers → Manage → Active numbers
TWILIO_PHONE_NUMBER=
# Console → Voice → TwiML Apps (AP...)
TWILIO_TWIML_APP_SID=
# Console → Conversations → Services (IS...)
TWILIO_CONVERSATIONS_SERVICE_SID=

# --- Secrets (Secret Manager in production) ---
# Shown once when the API key is created
TWILIO_API_KEY_SECRET=
# Console home page → Account Info → Auth Token
TWILIO_AUTH_TOKEN=
# Generate: openssl rand -hex 32
SESSION_SECRET=
# Marie's login password
MARIE_PASSWORD=
# OpenAI project key used for support drafts and guarded inbound classification
OPENAI_API_KEY=
# Shared only by the Gmail ingestion monitor and the Cloud Run endpoint
MEETING_ALERT_SECRET=

# --- Optional ---
# Forward unanswered inbound calls here (E.164); else voicemail
VOICE_FALLBACK_NUMBER=
# Public URL of the deployed app. REQUIRED in production (webhook signature
# validation behind the Cloud Run proxy). Set after the first deploy.
APP_BASE_URL=
# Canonical user-facing browser URL. Keep separate from APP_BASE_URL when
# Twilio and scheduler callbacks still target the direct Cloud Run hostname.
PUBLIC_APP_URL=https://phone.tribeharbor.com
# Low-latency model for support drafting and message classification
OPENAI_MODEL=gpt-5.6-terra
# OIDC identity allowed to invoke the meeting reminder scheduler route
MEETING_SCHEDULER_SERVICE_ACCOUNT=
# Private Google Cloud Storage bucket used for durable meeting state
MEETING_STATE_BUCKET=

# --- Command Center sync ---
# Google Sheet ID containing "People & Agencies", "Open Actions", and
# "Activity Log". The Cloud Run runtime service account must be an Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- SAB HighLevel read-only mirror ---
# Keep disabled until the private integration token, immutable record allowlist,
# and approved requirement field mapping are configured.
SAB_SYNC_ENABLED=false
SAB_HIGHLEVEL_LOCATION_ID=
SAB_HIGHLEVEL_AGENCY_SCHEMA_KEY=custom_objects.agencies
SAB_HIGHLEVEL_TOKEN=
# JSON arrays. Scope membership MUST use immutable HighLevel record IDs.
SAB_SYNC_SCOPE_JSON=[]
SAB_REQUIREMENT_FIELDS_JSON=[]
